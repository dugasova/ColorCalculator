# Dummy Firebase config for Vitest (mode "test" loads this over .env).
# Committed on purpose: keeps tests off the real project, locally and in CI.

VITE_FIREBASE_API_KEY="test-api-key"
VITE_FIREBASE_AUTH_DOMAIN="test.auth-domain"
VITE_FIREBASE_PROJECT_ID="demo-test"
VITE_FIREBASE_STORAGE_BUCKET="test-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="test-sender-id"
VITE_FIREBASE_APP_ID="test-app-id"
VITE_FIREBASE_MEASUREMENT_ID="test-measurement-id"

# Optional: where testers send feedback (e.g. https://t.me/<username> or mailto:you@example.com). Hidden when empty.
VITE_FEEDBACK_URL=

# Optional: Sentry error reporting (production builds only). Hidden/off when empty.
VITE_SENTRY_DSN=
