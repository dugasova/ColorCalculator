# Firebase config for the Playwright end-to-end tests (`vite --mode e2e`, see e2e/).
# Committed on purpose: every value is a placeholder, and the "demo-" project id makes
# the Firebase emulators refuse to talk to any real project.

VITE_FIREBASE_API_KEY=e2e-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-formulist.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-formulist
VITE_FIREBASE_STORAGE_BUCKET=demo-formulist.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_FIREBASE_MEASUREMENT_ID=

# Points the app at the local Auth and Firestore emulators (src/firebase.ts).
VITE_FIREBASE_EMULATORS=true

VITE_FEEDBACK_URL=
VITE_SENTRY_DSN=
